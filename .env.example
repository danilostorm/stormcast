# Copie para /etc/stormcast.env no servidor. Nunca envie valores reais ao Git.
STORMCAST_ADMIN_NAME="Administrador StormCast"
STORMCAST_ADMIN_EMAIL="admin@stormcast.site"
STORMCAST_ADMIN_PASSWORD="troque-por-uma-senha-longa-e-unica"

# Banco SQLite persistente da instalação Ubuntu.
STORMCAST_DB_PATH="/var/lib/stormcast/stormcast.db"

# Opcional: 1 fecha novos cadastros públicos.
STORMCAST_DISABLE_REGISTRATION="0"

# Opcional: validade da sessão, entre 1 e 90 dias.
STORMCAST_SESSION_DAYS="30"

# Processamento híbrido real: Ubuntu executa yt-dlp/FFmpeg e a OpenAI
# transcreve e escolhe os melhores trechos. Nunca envie esta chave ao Git.
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_ANALYSIS_MODEL="gpt-5-mini"
STORMCAST_PROCESSOR_ENABLED="0"

# Ferramentas e armazenamento privado dos vídeos.
STORMCAST_YTDLP_PATH="/opt/stormcast-tools/bin/yt-dlp"
STORMCAST_FFMPEG_PATH="/usr/bin/ffmpeg"
STORMCAST_FFPROBE_PATH="/usr/bin/ffprobe"
STORMCAST_PYTHON_PATH="/opt/stormcast-tools/bin/python"
STORMCAST_MEDIA_DIR="/var/lib/stormcast/media"
STORMCAST_MAX_VIDEO_MINUTES="90"
STORMCAST_MIN_FREE_GB="5"
STORMCAST_FFMPEG_THREADS="8"
STORMCAST_PROCESSOR_POLL_MS="3000"

# Opcional: arquivo Netscape de cookies de uma conta autorizada a acessar
# vídeos próprios. Deixe vazio enquanto o YouTube não exigir autenticação.
STORMCAST_YTDLP_COOKIES=""
