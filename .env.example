# Copie para /etc/stormcast.env no servidor. Nunca envie valores reais ao Git.
STORMCAST_ADMIN_NAME="Administrador StormCast"
STORMCAST_ADMIN_EMAIL="admin@stormcast.site"
STORMCAST_ADMIN_PASSWORD="troque-por-uma-senha-longa-e-unica"

# Banco SQLite persistente da instalação Ubuntu.
STORMCAST_DB_PATH="/var/lib/stormcast/stormcast.db"

# Opcional: 1 fecha novos cadastros públicos.
STORMCAST_DISABLE_REGISTRATION="0"

# Opcional: validade da sessão, entre 1 e 90 dias.
STORMCAST_SESSION_DAYS="30"
